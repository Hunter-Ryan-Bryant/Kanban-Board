# Copy this file to .env and fill in your Supabase project's values.
# Both are under Project Settings -> API in the Supabase dashboard.
# The publishable (anon) key is safe to expose in the browser; never put a
# secret / service_role key here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key
# Copy this file to .env and fill in your Supabase project's values
# (Supabase dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
